{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLOS Canonical Speaker-Cued Transcript v1",
  "description": "Input contract for full-episode timeline generation. Transcript text must be author-confirmed against the canonical screenplay; the aligner still fails closed on any token mismatch.",
  "type": "object",
  "required": ["transcript_version", "approval_status", "utterances"],
  "properties": {
    "transcript_version": {"type": "string", "minLength": 1},
    "approval_status": {"const": "approved"},
    "utterances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["speaker", "text"],
        "properties": {
          "utterance_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string", "minLength": 1},
          "speaker": {"type": "string", "enum": ["KEVIN", "KHALED", "ORBIT", "THE_MOON"]},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
