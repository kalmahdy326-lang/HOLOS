{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holos.example/schemas/holos-asset-acceptance-checks-v1.schema.json",
  "title": "HOLOS Asset Acceptance Checks v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "project",
    "episode",
    "version",
    "result_statuses",
    "universal_checks",
    "asset_types",
    "result_template",
    "catalog_boundary"
  ],
  "properties": {
    "record_type": {
      "const": "ASSET_ACCEPTANCE_CHECKS"
    },
    "project": {
      "const": "HOLOS"
    },
    "episode": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "result_statuses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOT_RUN",
          "PASS",
          "FAIL",
          "BLOCKED",
          "NOT_APPLICABLE"
        ]
      }
    },
    "catalog_boundary": {
      "type": "string",
      "minLength": 1
    },
    "universal_checks": {
      "$ref": "#/$defs/checkList"
    },
    "asset_types": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "$ref": "#/$defs/checkList"
          }
        }
      }
    },
    "result_template": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "criterion",
        "evidence_required",
        "applicability",
        "mandatory",
        "default_result"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "criterion": {
          "type": "string",
          "minLength": 1
        },
        "evidence_required": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "default_result": {
          "const": "NOT_RUN"
        }
      }
    },
    "checkList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      },
      "uniqueItems": true
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "status",
        "asset_id",
        "asset_sha256",
        "asset_version",
        "asset_type",
        "production_use",
        "results",
        "acceptance_decision",
        "accepted",
        "reviewer",
        "reviewed_at",
        "approval_purpose",
        "limitations"
      ],
      "properties": {
        "record_type": {
          "const": "ASSET_ACCEPTANCE_RESULT"
        },
        "status": {
          "const": "PENDING"
        },
        "asset_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-fA-F]{64})$|^$"
        },
        "asset_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "asset_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "production_use": {
          "type": [
            "string",
            "null"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "status",
              "evidence",
              "notes"
            ],
            "properties": {
              "check_id": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "status": {
                "const": "NOT_RUN"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "string"
              }
            }
          }
        },
        "acceptance_decision": {
          "const": "PENDING"
        },
        "accepted": {
          "const": false
        },
        "reviewer": {
          "type": "null"
        },
        "reviewed_at": {
          "type": "null"
        },
        "approval_purpose": {
          "type": "null"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
