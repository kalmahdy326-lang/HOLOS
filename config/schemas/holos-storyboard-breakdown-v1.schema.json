{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLOS Episode 1 Storyboard Breakdown v1",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "project_author",
    "title",
    "source",
    "approval_status",
    "delivery_reference",
    "timing_policy",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_id": {
      "const": "holos-episode1-body-storyboard-v1"
    },
    "project_author": {
      "const": "Khaled AL-MAHDY"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "path",
        "github_blob_sha",
        "original_filename",
        "provenance_status",
        "document_status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "github_blob_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "original_filename": {
          "type": "string"
        },
        "provenance_status": {
          "type": "string"
        },
        "document_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "approval_status": {
      "type": "string",
      "pattern": "^DRAFT"
    },
    "delivery_reference": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps",
        "status"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "timing_policy": {
      "type": "string",
      "minLength": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "number",
          "title",
          "location",
          "pages",
          "continuity",
          "shots"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "pages": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 25
              },
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 25
              }
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "continuity": {
            "type": "string"
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^(S0[1-7]_[0-9]{3}|PC_[0-9]{3})$"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
