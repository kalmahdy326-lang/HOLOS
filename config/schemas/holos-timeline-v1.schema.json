{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLOS Event Timeline v1",
  "description": "Structural schema for tools/build_holos_full_episode_timeline.py output. Sequence, measured-duration, transcript-token and event-count consistency remain semantic validations in Python/Godot.",
  "type": "object",
  "required": [
    "schema_version",
    "events",
    "status",
    "timebase",
    "source_audio_name",
    "source_audio_sha256",
    "alignment_name",
    "alignment_sha256",
    "approved_transcript",
    "speech_word_envelope_seconds",
    "asr_normalizations",
    "alignment_method",
    "limitations",
    "phoneme_count",
    "silence_event_count",
    "event_count"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"type": "string"},
    "timebase": {
      "type": "string",
      "enum": ["absolute_source_audio_seconds", "review_wav_relative_seconds"]
    },
    "source_audio_name": {"type": "string", "minLength": 1},
    "source_audio_sha256": {"$ref": "#/$defs/sha256"},
    "alignment_name": {"type": "string", "minLength": 1},
    "alignment_sha256": {"$ref": "#/$defs/sha256"},
    "approved_transcript": {
      "type": "array",
      "items": {"$ref": "#/$defs/turn"}
    },
    "speech_word_envelope_seconds": {"$ref": "#/$defs/envelope"},
    "asr_normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "asr", "approved", "start", "end"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "asr": {"type": "string"},
          "approved": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": false
      }
    },
    "alignment_method": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "phoneme_count": {"type": "integer", "minimum": 0},
    "silence_event_count": {"type": "integer", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 1},
    "review_wav_name": {"type": "string", "minLength": 1},
    "review_wav_sha256": {"$ref": "#/$defs/sha256"},
    "review_offset_seconds": {"type": "number", "minimum": 0},
    "absolute_source_timeline_sha256": {"$ref": "#/$defs/sha256"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"timebase": {"const": "review_wav_relative_seconds"}}, "required": ["timebase"]},
      "then": {"required": ["review_wav_name", "review_wav_sha256", "review_offset_seconds", "absolute_source_timeline_sha256"]},
      "else": {"not": {"anyOf": [{"required": ["review_wav_name"]}, {"required": ["review_wav_sha256"]}, {"required": ["review_offset_seconds"]}, {"required": ["absolute_source_timeline_sha256"]}]}}
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "turn": {
      "type": "object",
      "required": ["speaker", "text"],
      "properties": {
        "speaker": {"type": "string", "enum": ["KEVIN", "KHALED", "ORBIT", "THE_MOON"]},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["speaker", "start", "end", "phoneme", "viseme", "category", "source_word", "confidence", "verification_status", "notes"],
      "properties": {
        "speaker": {"type": "string", "enum": ["KEVIN", "KHALED", "ORBIT", "THE_MOON"]},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "phoneme": {"type": "string", "minLength": 1},
        "viseme": {"type": "string", "enum": ["rest", "closed", "open", "wide", "round", "teeth"]},
        "category": {"type": "string"},
        "source_word": {"type": ["string", "null"]},
        "acoustic_word": {"type": "string"},
        "acoustic_word_start": {"type": "number", "minimum": 0},
        "acoustic_word_end": {"type": "number", "exclusiveMinimum": 0},
        "acoustic_word_score": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verification_status": {"type": "string"},
        "notes": {"type": "string"},
        "asr_word": {"type": "string"},
        "normalization": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"phoneme": {"const": "SIL"}}, "required": ["phoneme"]},
          "then": {"properties": {"viseme": {"const": "rest"}, "source_word": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    }
  }
}
