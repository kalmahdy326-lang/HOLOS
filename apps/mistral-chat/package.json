{
  "name": "holos-mistral-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first HOLOS project chat using the official Mistral TypeScript SDK.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
