; Minimal Godot 4 project used to exercise the HOLOS shot runner.
config_version=5

[application]
config/name="HOLOS Adapter Test"
run/main_scene="res://test_scenes/adapter_test.tscn"

[display]
window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=320
window/size/window_height_override=180

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
